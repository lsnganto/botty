/* ============================================================
   Botty Launcher — QSS Theme
   Matches the Botty Client Launcher style (blue accent / light bg)
   ============================================================ */

/* ---- Global ---- */
QWidget {
    font-family: "Segoe UI", Arial, sans-serif;
    font-size: 13px;
    color: #222222;
    background-color: #f0f0f0;
}

QMainWindow {
    background-color: #f0f0f0;
}

/* ---- Sidebar ---- */
#sidebar {
    background-color: #ffffff;
    border-right: 1px solid #d4d4d4;
    min-width: 160px;
    max-width: 160px;
}

#sidebar_title {
    color: #0098c9;
    font-size: 18px;
    font-weight: bold;
    padding: 14px 16px 6px 16px;
    background-color: #ffffff;
    border-bottom: none;
}

#sidebar_separator {
    background-color: #d0d0d0;
    min-height: 1px;
    max-height: 1px;
    margin: 4px 12px;
}

QPushButton#nav_button {
    background-color: transparent;
    border: none;
    border-radius: 0px;
    text-align: left;
    padding: 7px 16px;
    color: #333333;
    font-size: 13px;
}

QPushButton#nav_button:hover {
    background-color: #e8f4f8;
    color: #0098c9;
}

QPushButton#nav_button[active="true"] {
    background-color: #ddeef5;
    color: #0098c9;
    font-weight: 600;
    border-left: 3px solid #0098c9;
    padding-left: 13px;
}

/* ---- Top bar ---- */
#top_bar {
    background-color: #f5f5f5;
    border-bottom: 1px solid #d4d4d4;
    min-height: 42px;
    max-height: 42px;
}

QPushButton#btn_save {
    background-color: #f0f0f0;
    border: 1px solid #c0c0c0;
    border-radius: 3px;
    padding: 5px 14px;
    color: #555555;
}
QPushButton#btn_save:hover { background-color: #e0e0e0; }
QPushButton#btn_save:disabled { color: #aaaaaa; }

QPushButton#btn_cancel {
    background-color: #f0f0f0;
    border: 1px solid #c0c0c0;
    border-radius: 3px;
    padding: 5px 14px;
    color: #555555;
}
QPushButton#btn_cancel:hover { background-color: #e0e0e0; }
QPushButton#btn_cancel:disabled { color: #aaaaaa; }

QPushButton#btn_wizard {
    background-color: transparent;
    border: none;
    padding: 5px 14px;
    color: #333333;
    font-weight: 600;
}
QPushButton#btn_wizard:hover { color: #0098c9; }

#changes_label {
    color: #00a651;
    font-size: 13px;
}

/* ---- Content Area ---- */
#content_area {
    background-color: #e8e8e8;
}

/* ---- Section / Group Boxes ---- */
QGroupBox {
    background-color: #ffffff;
    border: 1px solid #d8d8d8;
    border-radius: 4px;
    margin-top: 8px;
    font-weight: 600;
    color: #444444;
    padding: 12px 8px 8px 8px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 10px;
    top: -2px;
    padding: 0 4px;
    color: #555555;
    font-size: 12px;
    font-weight: 600;
}

/* ---- Info Banner ---- */
#info_banner {
    background-color: #0098c9;
    border-radius: 4px;
    color: #ffffff;
    font-size: 13px;
    padding: 12px 16px;
}

/* ---- ComboBox ---- */
QComboBox {
    border: 1px solid #c0c0c0;
    border-radius: 3px;
    padding: 5px 8px;
    background-color: #ffffff;
    min-height: 28px;
}

QComboBox:focus { border-color: #0098c9; }
QComboBox::drop-down { border: none; width: 24px; }
QComboBox::down-arrow { image: none; }
QComboBox QAbstractItemView {
    border: 1px solid #c0c0c0;
    background-color: #ffffff;
    selection-background-color: #0098c9;
    selection-color: #ffffff;
}

/* ---- LineEdit ---- */
QLineEdit {
    border: 1px solid #c0c0c0;
    border-radius: 3px;
    padding: 5px 8px;
    background-color: #ffffff;
    min-height: 26px;
}
QLineEdit:focus { border-color: #0098c9; }

/* ---- SpinBox / DoubleSpinBox ---- */
QSpinBox, QDoubleSpinBox {
    border: 1px solid #c0c0c0;
    border-radius: 3px;
    padding: 4px 8px;
    background-color: #ffffff;
    min-height: 26px;
}
QSpinBox:focus, QDoubleSpinBox:focus { border-color: #0098c9; }

/* ---- Labels ---- */
QLabel {
    color: #444444;
    background-color: transparent;
}
QLabel#section_label {
    color: #666666;
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

/* ---- CheckBox ---- */
QCheckBox {
    spacing: 6px;
    color: #333333;
}
QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #c0c0c0;
    border-radius: 3px;
    background-color: #ffffff;
}
QCheckBox::indicator:checked {
    background-color: #0098c9;
    border-color: #0098c9;
}

/* ---- Primary Action Button ---- */
QPushButton#btn_primary {
    background-color: #0098c9;
    color: #ffffff;
    border: none;
    border-radius: 3px;
    padding: 7px 18px;
    font-weight: 600;
}
QPushButton#btn_primary:hover { background-color: #007aaa; }
QPushButton#btn_primary:disabled { background-color: #c0c0c0; }

/* ---- Secondary Button ---- */
QPushButton#btn_secondary {
    background-color: #ffffff;
    color: #333333;
    border: 1px solid #c0c0c0;
    border-radius: 3px;
    padding: 7px 18px;
}
QPushButton#btn_secondary:hover { background-color: #f0f0f0; }

/* ---- Danger Button ---- */
QPushButton#btn_danger {
    background-color: #ffffff;
    color: #d9534f;
    border: 1px solid #d9534f;
    border-radius: 3px;
    padding: 7px 18px;
}
QPushButton#btn_danger:hover { background-color: #fdf5f5; }

/* ---- Run Order Panels ---- */
#panel_title {
    color: #888888;
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    padding: 8px 12px 4px 12px;
    background-color: #fafafa;
    border-bottom: 1px solid #e8e8e8;
}

QListWidget {
    background-color: #ffffff;
    border: none;
    outline: none;
}
QListWidget::item {
    padding: 9px 12px;
    border-bottom: 1px solid #f0f0f0;
    color: #333333;
}
QListWidget::item:hover { background-color: #f0f8fb; }
QListWidget::item:selected {
    background-color: #e3f3f9;
    color: #333333;
}

/* ---- Table Widget (Loot/Pickit) ---- */
QTableWidget {
    background-color: #ffffff;
    border: 1px solid #d8d8d8;
    gridline-color: #f0f0f0;
    border-radius: 3px;
    outline: none;
}
QTableWidget::item { padding: 4px 8px; }
QTableWidget::item:selected {
    background-color: #ddeef5;
    color: #222222;
}
QHeaderView::section {
    background-color: #f5f5f5;
    border: none;
    border-bottom: 1px solid #d8d8d8;
    border-right: 1px solid #e0e0e0;
    padding: 6px 8px;
    font-weight: 600;
    color: #555555;
    font-size: 12px;
}

/* ---- Tab Widget (Loot/Pickit categories) ---- */
QTabWidget::pane {
    border: 1px solid #d8d8d8;
    background-color: #ffffff;
    border-radius: 0 3px 3px 3px;
}
QTabBar::tab {
    background-color: #f0f0f0;
    border: 1px solid #d8d8d8;
    border-bottom: none;
    padding: 6px 14px;
    color: #555555;
    margin-right: 2px;
}
QTabBar::tab:selected {
    background-color: #ffffff;
    color: #0098c9;
    font-weight: 600;
    border-top: 2px solid #0098c9;
}
QTabBar::tab:hover:!selected { background-color: #e8e8e8; }

/* ---- Scroll Area ---- */
QScrollArea { border: none; background-color: transparent; }
QScrollBar:vertical {
    width: 8px;
    background: transparent;
    margin: 0;
}
QScrollBar::handle:vertical {
    background: #c8c8c8;
    border-radius: 4px;
    min-height: 24px;
}
QScrollBar::handle:vertical:hover { background: #aaaaaa; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }

/* ---- Status Bar ---- */
#status_bar {
    background-color: #ffffff;
    border-top: 1px solid #d4d4d4;
    min-height: 28px;
    max-height: 28px;
    padding: 0 12px;
}
#status_dot_stopped { color: #888888; font-size: 11px; }
#status_dot_running { color: #00a651; font-size: 11px; }
#status_dot_paused  { color: #f0a500; font-size: 11px; }

/* ---- Toggle Switch (rendered by widget) ---- */
/* ---- License link ---- */
#license_link {
    color: #444444;
    font-size: 13px;
    text-decoration: none;
    background-color: transparent;
}
#license_link:hover { color: #0098c9; }

/* ---- Radio Card (Game Settings page) ---- */
#radio_card {
    background-color: #ffffff;
    border: 1px solid #d0d0d0;
    border-radius: 4px;
}
#radio_card[selected="true"] {
    border: 2px solid #0098c9;
    background-color: #f5fbfd;
}

/* ---- Step badge (numbered circle) ---- */
#step_badge {
    background-color: #333333;
    color: #ffffff;
    border-radius: 11px;
    min-width: 22px;
    max-width: 22px;
    min-height: 22px;
    max-height: 22px;
    font-weight: bold;
    font-size: 12px;
}
